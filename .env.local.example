# ─── Email Configuration (contact form) ────────────────────────────────────
#
# 1. Open your Gmail → Google Account → Security → 2-Step Verification (enable if not on)
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → copy the 16-character password
# 4. Fill in the values below and rename this file to .env.local
#
GMAIL_USER=your.gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The email address where contact form submissions will be received
# Leave blank to use GMAIL_USER as the recipient
CONTACT_EMAIL=hello@bone-h.co.il
